# Copy to `.env` (gitignored) and fill in. Every backend speaks the OpenAI API
# shape, so any OpenAI-compatible server works — just point BASE_URL at it.

# ── LLM (required) ─────────────────────────────────────────────────────────
LLM_PROVIDER=openai              # openai | azure
LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1     # or http://localhost:8000/v1 for vLLM / Ollama / LiteLLM
LLM_MODEL=gpt-5                  # Azure: the deployment name
# AZURE_API_VERSION=2024-10-21   # Azure only
# LLM_MAX_RETRIES=2            # JSON/schema retries + connection/timeout retries; 0 = fail-fast
# LLM_TIMEOUT=600              # seconds per request
# LLM_MAX_COMPLETION_TOKENS=32768

# ── T2I (optional; default = self-hosted Qwen-Image behind an OpenAI-compatible server) ──
# T2I_MODEL=qwen-image             # or gpt-image-1, dall-e-3, flux, ...
# T2I_BASE_URL=http://localhost:8000/v1
# T2I_API_KEY=                     # falls back to LLM_API_KEY
# T2I_SIZE=1024x1024             # reference sheets
# T2I_KEYFRAME_SIZE=1280x720     # shot keyframes (defaults to VIDEO_SIZE; gpt-image-1 needs 1536x1024)

# ── Video / T2V / I2V (optional; default = self-hosted Wan 2.2 behind an OpenAI-compatible server) ──
# VIDEO_MODEL=wan22-t2v          # wan22-t2v | wan22-i2v | sora-2 | ltx-video ... — whatever your server exposes
# VIDEO_BASE_URL=http://localhost:8090/v1
# VIDEO_API_KEY=                 # falls back to LLM_API_KEY
# VIDEO_SIZE=1280x720
# VIDEO_FPS=16
# VIDEO_POLL_INTERVAL=5
# VIDEO_TIMEOUT=1800

# ── Misc ───────────────────────────────────────────────────────────────────
# TRACE_LOGS=0                   # disable per-agent markdown trace logs
# DISABLE_KNOWLEDGE=1            # ablation: do not inject the Production Rulebook
